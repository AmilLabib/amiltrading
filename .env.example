# Salin jadi .env.local untuk development lokal. Di Vercel, isi lewat Project Settings > Environment Variables.

# Password untuk masuk ke diary
APP_PASSWORD=ganti-dengan-password-kamu

# String acak panjang untuk menandatangani cookie login (min. 16 karakter)
# Bikin cepat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Otomatis terisi kalau connect Upstash Redis lewat Vercel Marketplace.
# Kosongkan saat dev lokal untuk pakai database sementara di memori.
KV_REST_API_URL=
KV_REST_API_TOKEN=
